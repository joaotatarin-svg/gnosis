msgstr "Guardian  ·  "

#. bestiary_lore.category.d8f090  [ui]
#: scripts/data/bestiary_lore.gd:222
msgid "Arconte  ·  Espelho"
msgstr "Archon  ·  Mirror"

#. bestiary_lore.category.de87bb  [ui]
#: scripts/data/bestiary_lore.gd:223
msgid "Criatura do Kenoma"
msgstr "Creature of the Kenoma"

